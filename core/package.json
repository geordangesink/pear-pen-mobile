{
  "name": "pear-pen-core",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "overrides": {
    "hypercore-signing-request": {
      "hypercore": "^11.40.3",
      "hyperdrive": "^13.3.4"
    }
  },
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "#runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  },
  "dependencies": {
    "@holepunchto/multisig-tools": "^5.0.3",
    "b4a": "^1.8.0",
    "bare-events": "^2.6.1",
    "bare-fs": "^4.5.1",
    "bare-path": "^3.1.2",
    "bare-storage": "^1.1.1",
    "compact-encoding": "^2.18.0",
    "corestore": "^7.16.1",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hypercore": "^11.20.1",
    "hypercore-crypto": "^3.6.1",
    "hypercore-id-encoding": "^1.3.0",
    "hypercore-sign": "3.0.0",
    "hypercore-signing-request": "^4.0.2",
    "hyperdrive": "^13.0.2",
    "hyperswarm": "^4.17.2",
    "pear-mobile": "^4.3.0",
    "pear-runtime": "^1.3.1",
    "protomux": "^3.12.1",
    "sodium-native": "^5.0.10",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  }
}
